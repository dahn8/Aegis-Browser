<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/player_layer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:visibility="gone">

    <FrameLayout
        android:id="@+id/player_stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <SurfaceView
            android:id="@+id/player_surface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <LinearLayout
            android:id="@+id/player_audio_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/ic_audio_wave"
                android:tint="#FF6E7681" />

            <TextView
                android:id="@+id/player_audio_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:maxWidth="260dp"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="middle"
                android:textColor="#FFD5D9DF"
                android:textSize="14sp" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/player_loading"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:indeterminateTint="#FFFFFFFF" />

        <TextView
            android:id="@+id/player_error"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:textColor="#FFB9BEC6"
            android:textSize="14sp"
            android:visibility="gone" />
    </FrameLayout>

    <ImageButton
        android:id="@+id/player_close"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="32dp"
        android:layout_marginEnd="12dp"
        android:background="#66000000"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_close"
        android:tint="#FFFFFFFF" />

    <LinearLayout
        android:id="@+id/player_controls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#99000000"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="14dp"
        android:paddingTop="2dp"
        android:paddingBottom="10dp">

        <ImageButton
            android:id="@+id/player_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@null"
            android:contentDescription="@string/reload"
            android:src="@drawable/ic_play"
            android:tint="#FFFFFFFF" />

        <TextView
            android:id="@+id/player_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="46dp"
            android:text="00:00"
            android:textColor="#FFE6E9ED"
            android:textSize="12sp" />

        <SeekBar
            android:id="@+id/player_seek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progressTint="#FF6E8CF2"
            android:progressBackgroundTint="#33FFFFFF"
            android:thumbTint="#FFFFFFFF" />

        <TextView
            android:id="@+id/player_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="46dp"
            android:gravity="end"
            android:text="00:00"
            android:textColor="#FFE6E9ED"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
