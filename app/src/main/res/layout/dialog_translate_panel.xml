<?xml version="1.0" encoding="utf-8"?>
<!-- 翻译网页面板：参照 Via 的样式，目标语言 / 翻译源 / 自动翻译该网站 / 三个文字按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="0dp"
    android:paddingEnd="0dp"
    android:paddingTop="2dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/panel_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/translate_title"
        android:textColor="#16181C"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="22dp"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_target_label"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:text="@string/translate_target_language"
            android:textColor="#16181C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/panel_target_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_underline_blue"
            android:paddingBottom="5dp"
            android:textColor="#16181C"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_source_label"
            android:layout_width="92dp"
            android:layout_height="wrap_content"
            android:text="@string/translate_source_label"
            android:textColor="#16181C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/panel_source_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_panel_underline_grey"
            android:paddingBottom="5dp"
            android:textColor="#16181C"
            android:textSize="14sp" />
    </LinearLayout>

    <CheckBox
        android:id="@+id/panel_auto_translate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="40dp"
        android:text="@string/translate_auto_site"
        android:textColor="#8A8F98"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/panel_revert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:gravity="center"
            android:paddingStart="2dp"
            android:paddingEnd="10dp"
            android:text="@string/translate_ball_original"
            android:textColor="#E0533D"
            android:textSize="14sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/panel_translate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/translate_start"
            android:textColor="#1A73E8"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/panel_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="46dp"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="2dp"
            android:text="@string/cancel"
            android:textColor="#5F6368"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
