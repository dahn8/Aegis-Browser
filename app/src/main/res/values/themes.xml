<resources>
    <style name="Theme.Aegis" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 浅色背景下让状态栏时间/信号/电量图标变为深色 -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_light</item>
            <item name="android:alertDialogTheme">@style/Theme.Aegis.Dialog</item>
    </style>

    <style name="Theme.Aegis.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <!-- 深色背景下状态栏图标恢复为白色 -->
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
            <item name="android:alertDialogTheme">@style/Theme.Aegis.Dialog.Dark</item>
    </style>

    <style name="Theme.Aegis.Settings" parent="@android:style/Theme.Material.Light.NoActionBar">
        <!-- 关掉窗口进出动画：子页白底做缩放淡出时会在主页上留下透明白色残影 -->
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">@color/bg_light</item>
            <item name="android:alertDialogTheme">@style/Theme.Aegis.Dialog</item>
    </style>

    <style name="Theme.Aegis.Settings.Dark" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
            <item name="android:alertDialogTheme">@style/Theme.Aegis.Dialog.Dark</item>
    </style>

    <style name="NavButton">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@null</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:tint">?android:attr/textColorPrimary</item>
    </style>

    <style name="GroupTitle">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?android:attr/textColorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <!-- 页面设置弹窗：从右上角缩放展开/收回 -->
    <style name="WeatherPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/weather_pop_enter</item>
        <item name="android:windowExitAnimation">@anim/weather_pop_exit</item>
    </style>

    <style name="SettingsPopupAnimation">
        <item name="android:windowEnterAnimation">@anim/settings_pop_enter</item>
        <item name="android:windowExitAnimation">@anim/settings_pop_exit</item>
    </style>

    <!-- 统一弹窗样式：20dp 圆角卡片、主色文字按钮、轻遮罩 -->

    <!-- 统一自绘弹窗的窗口主题：透明背景，卡片由代码绘制 -->
    <style name="Theme.Aegis.Dialog.Card" parent="@android:style/Theme.Material.Light.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMajor">64%</item>
        <item name="android:windowMinWidthMinor">64%</item>
    </style>

    <style name="Theme.Aegis.Dialog.Card.Dark" parent="@android:style/Theme.Material.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:backgroundDimAmount">0.32</item>
        <item name="android:windowMinWidthMajor">64%</item>
        <item name="android:windowMinWidthMinor">64%</item>
    </style>

    <style name="Theme.Aegis.Dialog" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_surface</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:backgroundDimAmount">0.28</item>
        <item name="android:textAppearanceLarge">@style/AegisDialogTitle</item>
        <item name="android:textAppearanceMedium">@style/AegisDialogBody</item>
        <item name="android:buttonBarButtonStyle">@style/AegisDialogButton</item>
        <item name="android:borderlessButtonStyle">@style/AegisDialogButton</item>
    </style>

    <style name="Theme.Aegis.Dialog.Dark" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_surface_dark</item>
        <item name="android:colorAccent">@color/primary</item>
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:backgroundDimAmount">0.42</item>
        <item name="android:textAppearanceLarge">@style/AegisDialogTitle.Dark</item>
        <item name="android:textAppearanceMedium">@style/AegisDialogBody.Dark</item>
        <item name="android:buttonBarButtonStyle">@style/AegisDialogButton</item>
        <item name="android:borderlessButtonStyle">@style/AegisDialogButton</item>
    </style>

    <style name="AegisDialogTitle" parent="@android:style/TextAppearance.Material.Title">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#16181C</item>
    </style>

    <style name="AegisDialogTitle.Dark">
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#F2F4F7</item>
    </style>

    <style name="AegisDialogBody" parent="@android:style/TextAppearance.Material.Body1">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#5A616B</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="AegisDialogBody.Dark">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">#AEB5BF</item>
        <item name="android:lineSpacingMultiplier">1.3</item>
    </style>

    <style name="AegisDialogButton" parent="@android:style/Widget.Material.Button.Borderless">
        <item name="android:textColor">@color/primary</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.02</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingLeft">14dp</item>
        <item name="android:paddingRight">14dp</item>
    </style>
</resources>
