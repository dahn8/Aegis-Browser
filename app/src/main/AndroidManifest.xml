<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 允许用户主动安装下载的 APK（系统仍会逐次确认，不做静默安装） -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Android 11+ 包可见性：允许查询文件管理器与可打开各类文件的应用 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>

        <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Aegis">

        <activity
            android:name=".sections.SectionHostActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="http" />
                <data android:scheme="https" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SearchSettingsActivity"
            android:exported="false"
            android:label="@string/search_settings"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.AppThemeActivity"
            android:exported="false"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.TranslateSettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.PrivacySettingsActivity"
            android:exported="false"
            android:label="@string/privacy_settings"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.BlockLogActivity"
            android:exported="false"
            android:label="@string/block_log"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".bookmarks.BookmarksActivity"
            android:exported="false"
            android:label="@string/bookmarks"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".downloads.DownloadsActivity"
            android:exported="false"
            android:label="@string/download"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".history.HistoryActivity"
            android:exported="false"
            android:label="@string/history"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.GeneralSettingsActivity"
            android:exported="false"
            android:label="@string/general"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.AppearanceSettingsActivity"
            android:exported="false"
            android:label="@string/appearance"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.WallpaperActivity"
            android:exported="false"
            android:label="@string/wallpaper"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.WallpaperCropActivity"
            android:exported="false"
            android:label="@string/wallpaper_adjust"
            android:theme="@style/Theme.Aegis.Settings"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <activity
            android:name=".settings.ClearDataActivity"
            android:exported="false"
            android:label="@string/clear_browsing_data"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.WebSettingsActivity"
            android:exported="false"
            android:label="@string/web_settings"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.ActionSettingsActivity"
            android:exported="false" />
        <activity
            android:name=".settings.KeyboardShortcutsActivity"
            android:exported="false"
            android:label="@string/keyboard_shortcuts_help"
            android:theme="@style/Theme.Aegis.Settings" />
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.SiteDataActivity"
            android:exported="false"
            android:label="@string/site_data"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.SitePermissionsActivity"
            android:exported="false"
            android:label="@string/perm_settings"
            android:theme="@style/Theme.Aegis.Settings" />

        <activity
            android:name=".settings.SniffActivity"
            android:exported="false"
            android:label="@string/sniff"
            android:theme="@style/Theme.Aegis.Settings" />

        <provider
            android:name=".settings.UpdateFileProvider"
            android:authorities="${applicationId}.updates"
            android:exported="false"
            android:grantUriPermissions="true" />

    </application>
</manifest>
